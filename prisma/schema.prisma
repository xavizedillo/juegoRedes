datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model MatchTelemetry {
  id             String   @id @default(uuid())
  playerId       String
  partySize      Int
  floorReached   Int
  bossesDefeated Int
  goldCollected  Int
  status         String
  playtimeMinutes Int
  inventory      Json
  createdAt      DateTime @default(now())

  @@index([createdAt])
}
