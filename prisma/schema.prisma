datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model MatchTelemetry {
  id             String   @id @default(uuid())
  playerId       String
  partySize      Int
  floorReached   Int
  bossesDefeated Int
  goldCollected  Int
  status         String
  playtimeMinutes Int
  inventory      Json
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model User {
  id         String      @id
  name       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  savedGames SavedGame[]
}

model SavedGame {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lobbyId   String
  gameState Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, lobbyId])
  @@index([userId])
}
