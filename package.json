{
  "name": "juegoredes",
  "version": "1.0.0",
  "description": "RogueWeb: Echoes of the Grid - 2D Roguelike Multiplayer Game",
  "scripts": {
    "dev": "next dev",
    "dev:full": "tsx --tsconfig tsconfig.server.json server/index.ts",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && tsx --tsconfig tsconfig.server.json server/index.ts",
    "server": "tsx --tsconfig tsconfig.server.json server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xavizedillo/juegoRedes.git"
  },
  "keywords": [
    "roguelike",
    "multiplayer",
    "game"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "express": "^5.3.0",
    "next": "^15.1.3",
    "prisma": "^5.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.23.15",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitest/ui": "^5.0.5",
    "concurrently": "^10.0.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
